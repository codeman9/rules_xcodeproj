#!/bin/bash

# libtool wrapper for rules_xcodeproj Build with Bazel mode.
#
# Tries real libtool first. When the integrated Swift driver is active
# (SWIFT_USE_INTEGRATED_DRIVER = YES, i.e. previews enabled), swift-frontend
# creates real .o files and libtool archives them into a valid .a — needed for
# the Xcode Preview system to analyze static library targets.
#
# When .o files are missing or invalid (non-preview builds where swiftc_stub
# creates placeholders), libtool may fail and we fall back to writing a dummy
# dependency_info file.

set -euo pipefail

if /usr/bin/libtool "$@" 2>/dev/null; then
  exit 0
fi

# Fallback for non-preview builds
while test $# -gt 0
do
  case $1 in
  *_dependency_info.dat)
    printf "\0 \0" > "$1"
    break
    ;;
  esac

  shift
done
